[Unit]
Description=SLF Data Server
After=network.target

[Service]
Type=simple
User=slf
Group=slf
WorkingDirectory=/opt/slf/slf-server
EnvironmentFile=/opt/slf/slf-server/slf_api.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/slf/slf-server/venv/bin/python -m gunicorn --workers 1 --threads 4 --bind 127.0.0.1:5000 --timeout 30 --graceful-timeout 30 --access-logfile - --error-logfile - server:app
Restart=on-failure
RestartSec=2
TimeoutStopSec=35

[Install]
WantedBy=multi-user.target
